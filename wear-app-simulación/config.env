# wear-app-simulación — configuración
# TODO se ejecuta EN LA LAPTOP CachyOS (la cámara es local: /dev/video0).
# No se necesita SSH ni v4l2loopback: el emulador usa la cámara real directa.

# Ruta del Android SDK en la laptop (ajústala si es otra)
SDK="/home/renyam/Android/Sdk"

# AVD de pruebas. IMPORTANTE: usar una imagen de PHONE (google_apis),
# NO Wear OS: la imagen Wear OS no incluye HAL de cámara (no hay
# android.hardware.camera.provider en vendor/), así que la cámara del
# emulador no existe en el guest y CameraX falla con
# "No available camera can be found".
# Crear el AVD:
#   $SDK/cmdline-tools/latest/bin/avdmanager create avd -n phone_test \
#     -k "system-images;android-37.0;google_apis_playstore;x86_64"
AVD_NAME="phone_test"

# Cámara de la laptop (se usa solo para el fallback de frame estático)
VIDEO_DEV="/dev/video0"

# Resolución para el frame estático (fallback)
VIDEO_SIZE="640x480"
